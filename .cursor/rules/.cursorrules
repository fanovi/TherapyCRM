### Pattern Modello RequestType Aggiornato
```php
class RequestType extends ActiveRecord
{
    // Costanti per therapeutic_plan_rule
    const PLAN_OPTIONAL = 1;      // Piano terapeutico opzionale
    const PLAN_NOT_ALLOWED = 2;   // Piano terapeutico non associabile
    const PLAN_REQUIRED = 3;      // Piano terapeutico obbligatorio
    
    // Metodi helper per business logic
    public function isTherapeuticPlanRequired() {
        return $this->therapeutic_plan_rule === self::PLAN_REQUIRED;
    }
    
    public function allowsMultipleRequests() {
        return (bool) $this->allow_multiple_requests;
    }
    
    public function requiresTherapyAssignment() {
        return (bool) $this->require_therapy_assignment;
    }
    
    public function requiresNotes() {
        return (bool) $this->require_notes;
    }
    
    public function isActive() {
        return (bool) $this->is_active;
    }
    
    // Scope per filtrare tipi attivi
    public static function findActive() {
        return static::find()->where(['is_active' => true]);
    }
    
    // IMPORTANTE: Ordinamento per ID crescente (non alfabetico)
    public static function getForApi() {
        $requestTypes = static::findActive()
            ->orderBy(['id' => SORT_ASC])  // ID crescente, NON alphabetic
            ->all();
            
        $result = [];
        foreach ($requestTypes as $type) {
            $result[] = [
                'id' => $type->id,
                'name' => $type->name,
                'therapeutic_plan_rule' => $type->therapeutic_plan_rule,
                'therapeutic_plan_rule_label' => $type->getTherapeuticPlanRuleLabel(),
                'allow_multiple_requests' => (bool) $type->allow_multiple_requests,
                'require_therapy_assignment' => (bool) $type->require_therapy_assignment,
                'require_notes' => (bool) $type->require_notes,
                'is_active' => (bool) $type->is_active,
                // Helper flags per frontend
                'is_therapeutic_plan_required' => $type->isTherapeuticPlanRequired(),
                'is_therapeutic_plan_optional' => $type->therapeutic_plan_rule === self::PLAN_OPTIONAL,
                'is_therapeutic_plan_not_allowed' => $type->therapeutic_plan_rule === self::PLAN_NOT_ALLOWED,
            ];
        }
        return $result;
    }
    
    public function getTherapeuticPlanRuleLabel() {
        switch ($this->therapeutic_plan_rule) {
            case self::PLAN_OPTIONAL: return 'Opzionale';
            case self::PLAN_NOT_ALLOWED: return 'Non associabile';
            case self::PLAN_REQUIRED: return 'Obbligatorio';
            default: return 'Sconosciuto';
        }
    }
}
```

### Query Builder RequestTypeQuery Aggiornato
```php
class RequestTypeQuery extends ActiveQuery
{
    // Filtra solo tipi attivi
    public function active($active = true) {
        return $this->andWhere(['is_active' => $active ? 1 : 0]);
    }
    
    // Filtra per regola piano terapeutico
    public function requiresTherapeuticPlan() {
        return $this->andWhere(['therapeutic_plan_rule' => RequestType::PLAN_REQUIRED]);
    }
    
    // Filtra tipi che permettono richieste multiple
    public function allowsMultiple() {
        return $this->andWhere(['allow_multiple_requests' => 1]);
    }
    
    // Filtra tipi che richiedono note
    public function requiresNotes() {
        return $this->andWhere(['require_notes' => 1]);
    }
    
    // Filtra tipi che richiedono assegnazione terapia
    public function requiresTherapyAssignment() {
        return $this->andWhere(['require_therapy_assignment' => 1]);
    }
}
```

## ⚠️ PATTERN VALIDAZIONE DINAMICA AGGIORNATA

### Validazione Basata su Nuovi Campi
```php
// In RequestsController o simile
private function validateRequestTypeRequirements($data, $requestType) {
    $errors = [];
    
    // Validazione piano terapeutico
    if ($requestType['is_therapeutic_plan_required'] && empty($data['therapeutic_plan_id'])) {
        $errors['therapeutic_plan_id'][] = "Piano terapeutico obbligatorio per '{$requestType['name']}'";
    }
    
    if ($requestType['is_therapeutic_plan_not_allowed'] && !empty($data['therapeutic_plan_id'])) {
        $errors['therapeutic_plan_id'][] = "Piano terapeutico non permesso per '{$requestType['name']}'";
    }
    
    // Validazione assegnazione terapia
    if ($requestType['require_therapy_assignment'] && empty($data['assigned_therapist_id'])) {
        $errors['assigned_therapist_id'][] = "Assegnazione terapista obbligatoria per '{$requestType['name']}'";
    }
    
    // Validazione note obbligatorie
    if ($requestType['require_notes'] && empty($data['notes'])) {
        $errors['notes'][] = "Note obbligatorie per '{$requestType['name']}'";
    }
    
    // Controllo richieste multiple
    if (!$requestType['allow_multiple_requests']) {
        $existingRequests = DocumentRequest::find()
            ->where(['user_id' => $data['user_id'], 'type_id' => $requestType['id']])
            ->andWhere(['status' => ['pending', 'processing']])
            ->count();
            
        if ($existingRequests > 0) {
            $errors['type_id'][] = "Richiesta già presente per '{$requestType['name']}'. Multiple non consentite.";
        }
    }
    
    return $errors;
}
```

