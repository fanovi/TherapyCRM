### Controller Pattern Aggiornato
```php
public function actionTypes() {
    try {
        $currentUser = Yii::$app->user->identity;
        if (!$currentUser) {
            throw new UnauthorizedHttpException('Utente non autenticato');
        }
        
        Yii::info("Request types accessed by user ID: {$currentUser->id}", __METHOD__);
        
        // Una sola query - ottimizzazione performance
        $requestTypes = RequestType::getForApi();
        
        if (empty($requestTypes)) {
            return [
                'success' => true,
                'data' => [],
                'meta' => [
                    'total' => 0,
                    'active_count' => 0,
                    'message' => 'Nessuna tipologia di richiesta configurata'
                ]
            ];
        }
        
        // Calcola metadati dalle tipologie (evita query aggiuntive)
        $activeCount = count($requestTypes);
        $ruleDistribution = [];
        foreach ($requestTypes as $type) {
            $rule = (string)$type['therapeutic_plan_rule'];
            $ruleDistribution[$rule] = ($ruleDistribution[$rule] ?? 0) + 1;
        }
        
        return [
            'success' => true,
            'data' => $requestTypes,
            'meta' => [
                'total' => $activeCount,
                'active_count' => $activeCount,
                'rule_distribution' => $ruleDistribution,
                'rules' => [
                    '1' => 'Opzionale',
                    '2' => 'Non associabile', 
                    '3' => 'Obbligatorio'
                ]
            ]
        ];
        
    } catch (UnauthorizedHttpException $e) {
        return $this->formatErrorResponse('UNAUTHORIZED', $e->getMessage(), [], 401);
        
    } catch (\Exception $e) {
        Yii::error("Error in RequestsController::actionTypes: " . $e->getMessage(), __METHOD__);
        return $this->formatErrorResponse('INTERNAL_ERROR', 'Errore interno del server', [], 500);
    }
}
```

