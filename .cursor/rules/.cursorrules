    ['Copia Piano Terapeutico', 3, 0, 0, 0, 1],     // Plan obbligatorio
    ['Relazione terapista', 3, 0, 1, 0, 1],         // Plan obbligatorio + terapia assegnata
    ['Relazione visita specialistica', 2, 0, 0, 0, 1], // Plan non associabile
