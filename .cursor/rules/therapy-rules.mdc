### Controllo Limite Ore Settimanali
```php
public function validateWeeklyHours($attribute, $params)
{
    $weekStart = date('Y-m-d', strtotime('monday this week', strtotime($this->appointment_datetime)));
    $weekEnd = date('Y-m-d', strtotime('sunday this week', strtotime($this->appointment_datetime)));
    
    $weeklyMinutes = Appointment::find()
        ->where(['therapist_id' => $this->therapist_id])
        ->andWhere(['between', 'DATE(appointment_datetime)', $weekStart, $weekEnd])
        ->sum('duration_minutes');
        
    $therapist = Therapist::findOne($this->therapist_id);
    if (($weeklyMinutes + $this->duration_minutes) > ($therapist->weekly_hours_contract * 60)) {
        $this->addError($attribute, 'Superamento ore settimanali contratto.');
    }
}
```

