    'errorAction' => 'error/index',
],
```

**CONTROLLER**: `api/controllers/ErrorController.php` converte automaticamente eccezioni Yii2:
```php
public function actionIndex()
{
    $exception = Yii::$app->errorHandler->exception;
    
    $codeMap = [
        'yii\web\UnauthorizedHttpException' => 'UNAUTHORIZED',
        'yii\web\ForbiddenHttpException' => 'ACCESS_DENIED',
        'yii\web\NotFoundHttpException' => 'NOT_FOUND',
        'yii\web\BadRequestHttpException' => 'BAD_REQUEST',
    ];
    
    $code = $codeMap[get_class($exception)] ?? 'INTERNAL_ERROR';
    
    return [
        'success' => false,
        'error' => $exception->getMessage(),
        'code' => $code
    ];
}
```

