        return [
            [['patient_id', 'start_date', 'duration_days', 'health_regime'], 'required'],
            ['health_regime', 'in', 'range' => ['L11', 'L11DOM', 'L11PG', 'L11SEM', 'ABA', 'FKT', 'Private', 'PDOM', 'Other']],
            ['status', 'in', 'range' => ['draft', 'active', 'expired', 'renewed']],
